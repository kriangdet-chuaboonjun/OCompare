{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OCompare",
  "version": "0.4.6",
  "identifier": "th.co.fusionsoft.ocompare.rust",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OCompare",
        "width": 1400,
        "height": 900,
        "dragDropEnabled": true,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "resources": {
      "explorer/*": "resources/explorer/"
    },
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwREY2RkRFREIyQThBREMKUldUY2lpcmIzbS9mY0hDYU8vZlB0OWVKcjRHeDhzck1pZEh5VytBaFFOUkhqbDRGQmdNUDJIdXEK",
      "endpoints": [
        "https://github.com/kriangdet-chuaboonjun/OCompare/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive",
        "installerArgs": [
          "/SILENT",
          "/SP-",
          "/NORESTART"
        ]
      }
    }
  }
}
